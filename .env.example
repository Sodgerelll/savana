VITE_FIRESTORE_DATABASE_ID=(default)

# Bonum PSP (server-side only — do NOT prefix with VITE_)
BONUM_BASE_URL=https://apis.bonum.mn
BONUM_APP_SECRET=
BONUM_TERMINAL_ID=
BONUM_CHECKSUM_KEY=
# Optional: enables webhook→Firestore auto-update (Firebase Admin service account JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional: overrides the webhook callback base URL (default: VERCEL_URL)
BONUM_CALLBACK_BASE_URL=

# Google Analytics (GA4) Data API — powers /api/analytics/summary (admin
# dashboard + public footer visitor stats). Server-side only — do NOT prefix
# with VITE_.
#   GA4_PROPERTY_ID — numeric GA4 property ID (GA4 Admin → Property Settings).
#                     NOT the same as the "G-XXXX" measurement ID in src/lib/firebase.ts.
#   GA4_SERVICE_ACCOUNT_JSON — a Service Account JSON key granted "Viewer" on
#                     the GA4 property (GA4 Admin → Property Access Management).
#                     Falls back to FIREBASE_SERVICE_ACCOUNT_JSON above if that
#                     service account was also granted GA4 Viewer access.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# AI Chat (api/chat/*) — server-side only, do NOT prefix with VITE_.
#   GEMINI_API_KEY  — https://aistudio.google.com/app/apikey. Without it the
#                     assistant routes return an error and the bot stays silent.
#   GEMINI_MODELS   — optional comma-separated fallback chain override. Default:
#                     gemini-3-flash-preview,gemini-2.5-flash,gemini-flash-latest
#   FB_VERIFY_TOKEN — random 32+ char string; must match the value entered in
#                     Meta's webhook setup screen.
#   FB_PAGE_ACCESS_TOKEN — the page token the bot replies with. Use a
#                     never-expiring one: exchange a short-lived user token for
#                     a long-lived one, then read the page token off
#                     /me/accounts — page tokens derived that way do not expire.
#                     Setting this is what turns Messenger on; there is no
#                     switch for it in the admin panel.
#   FB_APP_SECRET   — Meta app secret (Settings → Basic). Used to verify the
#                     X-Hub-Signature-256 on every delivery. Without it anyone
#                     who learns the webhook URL can post fabricated events.
#   IG_IS_ACTIVE    — optional "false" to keep Instagram Direct off. Instagram
#                     rides on the same page token and is on by default.
#   FB_REPLY_TO_COMMENTS — optional "true" to auto-reply to post comments.
#   FB_PAGE_ID      — optional; only used to ignore the page's own comments.
# None of the Facebook values are stored in Firestore or reach the browser: the
# admin panel shows whether the connection works, never what it is.
# Chat webhooks write through the Admin SDK, so FIREBASE_SERVICE_ACCOUNT_JSON
# above is required for Facebook/Instagram replies to be persisted.
GEMINI_API_KEY=
GEMINI_MODELS=
FB_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
IG_IS_ACTIVE=
FB_REPLY_TO_COMMENTS=
FB_PAGE_ID=
VITE_SYSADMIN_UIDS=
VITE_ADMIN_UIDS=
VITE_WORKER_UIDS=
VITE_SYSADMIN_EMAILS=
VITE_ADMIN_EMAILS=
VITE_WORKER_EMAILS=
VITE_SYSADMIN_PHONES=
VITE_ADMIN_PHONES=
VITE_WORKER_PHONES=
VITE_FIREBASE_API_KEY=AIzaSyCBiNJtQBZdVs4INEL_hI_-1S1x_yZkzII
# Fallback auth domain for local dev only. On deployed https hosts the app
# automatically uses its own hostname as authDomain (see src/lib/firebase.ts +
# the /__/auth proxy rewrites in vercel.json) so redirect sign-in survives
# Safari/iOS PWA storage partitioning.
VITE_FIREBASE_AUTH_DOMAIN=savana-3f45a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=savana-3f45a
VITE_FIREBASE_STORAGE_BUCKET=savana-3f45a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=596547804022
VITE_FIREBASE_APP_ID=1:596547804022:web:ec42a071568c21397f3857
