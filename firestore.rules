rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function canWriteStorefront() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    function isRegisteredUser() {
      return canWriteStorefront();
    }

    function isSelf(userId) {
      return isRegisteredUser() && request.auth.uid == userId;
    }

    function profileRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasProfile() {
      return isRegisteredUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasPrivilegedProfileRole() {
      return hasProfile()
        && (profileRole() == "admin" || profileRole() == "sysadmin");
    }

    /**
     * Everyone who works here — the shop floor included. "worker" used to be a role the
     * rules never recognised, so a worker saw every factory screen fail with a permission
     * error. Factory data is theirs to read and write; money and customer data are not.
     */
    function hasStaffProfileRole() {
      return hasProfile()
        && (profileRole() == "worker" || profileRole() == "admin" || profileRole() == "sysadmin");
    }

    // Rules cannot loop, so this unrolls the comparison for up to 20 variants — far more
    // than any product carries. A list longer than that is simply refused to staff.
    function variantUnchanged(before, after, index) {
      return after.size() <= index
        || (after[index].name == before[index].name
          && after[index].get("price", null) == before[index].get("price", null));
    }

    function variantNamesAndPricesUnchanged(before, after) {
      return before is list && after is list
        && after.size() == before.size()
        && after.size() <= 20
        && variantUnchanged(before, after, 0) && variantUnchanged(before, after, 1)
        && variantUnchanged(before, after, 2) && variantUnchanged(before, after, 3)
        && variantUnchanged(before, after, 4) && variantUnchanged(before, after, 5)
        && variantUnchanged(before, after, 6) && variantUnchanged(before, after, 7)
        && variantUnchanged(before, after, 8) && variantUnchanged(before, after, 9)
        && variantUnchanged(before, after, 10) && variantUnchanged(before, after, 11)
        && variantUnchanged(before, after, 12) && variantUnchanged(before, after, 13)
        && variantUnchanged(before, after, 14) && variantUnchanged(before, after, 15)
        && variantUnchanged(before, after, 16) && variantUnchanged(before, after, 17)
        && variantUnchanged(before, after, 18) && variantUnchanged(before, after, 19);
    }

    // Journal entries a factory worker's own actions produce. Everything else in the ledger
    // stays admin-only.
    function isFactorySourceType(sourceType) {
      return sourceType == "productionBatch"
        || sourceType == "rawMaterialPurchase"
        || sourceType == "rawMaterialUsage";
    }

    // A counter may only ever move forward by one, or restart at 1 when its year rolls over
    // (see reserveDocumentNumber in src/lib/documentNumbers.ts). Used for the two counters
    // staff advance, so a worker cannot rewind a series and hand out a number twice.
    function isNextCounterValue() {
      return request.resource.data.keys().hasOnly(["lastNumber", "year", "prefix"])
        && request.resource.data.lastNumber is int
        && (resource == null
          ? request.resource.data.lastNumber == 1
          : (request.resource.data.year == resource.data.year
            ? request.resource.data.lastNumber == resource.data.lastNumber + 1
            : request.resource.data.lastNumber == 1));
    }

    function isValidUserRole(role) {
      return role == "customer"
        || role == "worker"
        || role == "admin"
        || role == "sysadmin";
    }

    function isOrderOwner() {
      return isSignedIn() && request.auth.uid == resource.data.auth.uid;
    }

    // Chat conversations started from the storefront widget carry the signed-in
    // uid when there is one; Facebook/Instagram threads have no uid at all, so
    // the null guard keeps those admin-only rather than world-readable.
    function isChatConversationOwner() {
      return isSignedIn()
        && resource.data.userId != null
        && resource.data.userId == request.auth.uid;
    }

    function isChatMessageOwner(conversationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chat_conversations/$(conversationId))
        && get(/databases/$(database)/documents/chat_conversations/$(conversationId)).data.userId != null
        && get(/databases/$(database)/documents/chat_conversations/$(conversationId)).data.userId == request.auth.uid;
    }

    function isOrderStatus(status) {
      return status == "new"
        || status == "paid"
        || status == "delivering"
        || status == "delivered";
    }

    function isOrderSource(source) {
      return source == "web"
        || source == "messenger"
        || source == "facebook"
        || source == "instagram"
        || source == "phone"
        || source == "email"
        || source == "walk_in"
        || source == "gift"
        || source == "usage"
        || source == "other";
    }

    function isSettledOrderStatus(status) {
      return status == "paid"
        || status == "delivering"
        || status == "delivered";
    }

    function isValidContactMessage() {
      return request.resource.data.keys().hasOnly([
          "schemaVersion",
          "name",
          "email",
          "subject",
          "message",
          "createdAt",
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 160
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt == request.time;
    }

    match /sites/{siteId} {
      allow read: if true;
      allow create, update, delete: if hasPrivilegedProfileRole();

      match /settings/{documentId} {
        allow read: if true;
        allow create, update, delete: if hasPrivilegedProfileRole();
      }

      match /navigationItems/{documentId} {
        allow read: if true;
        allow create, update, delete: if hasPrivilegedProfileRole();
      }

      match /heroBanners/{documentId} {
        allow read: if true;
        allow create, update, delete: if hasPrivilegedProfileRole();
      }

      match /collections/{documentId} {
        allow read: if true;
        allow create, update, delete: if hasPrivilegedProfileRole();
      }

      match /products/{documentId} {
        allow read: if true;
        allow create, update, delete: if hasPrivilegedProfileRole();
      }

      match /markets/{documentId} {
        allow read: if true;
        allow create, update, delete: if hasPrivilegedProfileRole();
      }

      match /testimonials/{documentId} {
        allow read: if true;
        allow create, update, delete: if hasPrivilegedProfileRole();
      }

      match /discounts/{documentId} {
        allow read: if true;
        allow create, update, delete: if hasPrivilegedProfileRole();
      }

      match /contactMessages/{documentId} {
        allow create: if isValidContactMessage();
        allow read, update, delete: if hasPrivilegedProfileRole();
      }
    }

    // The catalogue. Readable by anyone (the storefront needs it), but writable only by
    // people who work here — it used to be writable by any signed-in shopper, which put
    // price, cost and stock in reach of every registered customer.
    match /products/{documentId} {
      allow read: if true;
      allow create, delete: if hasPrivilegedProfileRole();
      allow update: if hasPrivilegedProfileRole();
      // Staff move stock and record production cost; they never reprice the catalogue.
      // `variants` has to be writable for stock to move on a sized product, but each variant
      // also carries its own price — so a staff write must leave every variant's name and
      // price exactly as they were.
      allow update: if hasStaffProfileRole()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "totalStock",
          "soldCount",
          "variants",
          "costPrice",
          "updatedAt",
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["variants"])
          || variantNamesAndPricesUnchanged(resource.data.variants, request.resource.data.variants));
    }

    match /collections/{documentId} {
      allow read: if true;
      allow create, update, delete: if hasPrivilegedProfileRole();
    }

    match /packaging/{documentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if hasPrivilegedProfileRole();
    }

    // ─── Factory floor — readable and writable by staff, not just admins ────────
    match /rawMaterials/{documentId} {
      allow read, list: if hasStaffProfileRole();
      allow create, update, delete: if hasStaffProfileRole();
    }

    match /productionBatches/{documentId} {
      allow read, list: if hasStaffProfileRole();
      allow create, update, delete: if hasStaffProfileRole();
    }

    match /productionRecipes/{documentId} {
      allow read, list: if hasStaffProfileRole();
      allow create, update, delete: if hasStaffProfileRole();
    }

    match /rawMaterialPurchases/{documentId} {
      allow read, list: if hasStaffProfileRole();
      allow create, delete: if hasStaffProfileRole();
      allow update: if false;
    }

    match /orders/{orderId} {
      allow get: if isOrderOwner() || hasPrivilegedProfileRole();
      // Listing is for admins and for a signed-in shopper reading their own orders. There
      // used to be a `request.query.limit == 1` escape hatch here for order-number lookup:
      // rules cannot see a query's filters, so it let anyone — signed out included — pull
      // an arbitrary order document complete with the buyer's name, phone and address.
      // Order lookup now goes through /api/orders/lookup, which returns no personal data.
      allow list: if hasPrivilegedProfileRole()
        || (isSignedIn() && request.auth.uid == resource.data.auth.uid);
      // A storefront checkout. The shopper says what they want and where it goes; they do
      // not get to say what it costs or that it is paid. The order is saved with no invoice
      // and api/bonum/invoice.ts (Admin SDK) re-prices it from the catalogue, raises the
      // Bonum invoice for that figure and writes the invoice onto the order. The payment
      // fields below are pinned to their unpaid, invoice-less values, and there is no update
      // rule for the shopper at all — they used to be able to flip their own order to
      // "paid" without paying, and to attach any invoice id they liked.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          "orderNumber",
          "schemaVersion",
          "status",
          "source",
          "isManual",
          "currency",
          "auth",
          "customer",
          "address",
          "items",
          "totals",
          "payment",
          "stockApplied",
          "createdAt",
          "updatedAt",
        ])
        && request.resource.data.source == "web"
        && request.resource.data.isManual == false
        && request.resource.data.auth.uid == request.auth.uid
        && request.resource.data.auth.isAnonymous == (request.auth.token.firebase.sign_in_provider == "anonymous")
        && request.resource.data.status == "new"
        && request.resource.data.currency == "MNT"
        && request.resource.data.schemaVersion == 1
        && request.resource.data.customer.phoneNumber is string
        && request.resource.data.customer.phoneNumber.size() > 0
        && request.resource.data.address.region is string
        && request.resource.data.address.region.size() > 0
        && request.resource.data.address.districtOrSoum is string
        && request.resource.data.address.districtOrSoum.size() > 0
        && request.resource.data.address.khorooOrBag is string
        && request.resource.data.address.khorooOrBag.size() > 0
        && request.resource.data.address.streetAddress is string
        && request.resource.data.address.streetAddress.size() > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        // Rules cannot sum a list, so the line totals cannot be checked here — the server
        // re-prices every line before an invoice exists. This bound just keeps a single
        // order from carrying an unreasonable payload.
        && request.resource.data.items.size() <= 100
        && request.resource.data.payment.keys().hasOnly([
          "method", "provider", "status", "amount", "qrPayload", "invoiceId", "paidAt",
        ])
        && request.resource.data.payment.method == "bonum"
        && request.resource.data.payment.provider == "bonum"
        && request.resource.data.payment.status == "pending"
        && request.resource.data.payment.amount == request.resource.data.totals.grandTotal
        // A placeholder until the server writes the real link (AWAITING_INVOICE_QR).
        && request.resource.data.payment.qrPayload == "awaiting-invoice"
        && request.resource.data.payment.invoiceId == null
        && request.resource.data.payment.paidAt == null
        && request.resource.data.stockApplied == false
        // The fee comes from the shop settings and may be waived above a threshold, so it is
        // not pinned to a number here (a fixed 8000 broke every checkout the moment the fee
        // changed); the server re-derives it with the rest of the price.
        && request.resource.data.totals.shippingFee is number
        && request.resource.data.totals.shippingFee >= 0
        // Delivery is billed at cost and stays outside НӨАТ. "added" mode bills the tax on
        // top of the goods; the other modes leave the charged total untouched.
        && request.resource.data.totals.grandTotal == request.resource.data.totals.subtotal
          + request.resource.data.totals.shippingFee
          + (request.resource.data.totals.vatMode == "added" ? request.resource.data.totals.vatAmount : 0);
      // Orders an admin registers by hand (Messenger, phone, walk-in, …): no Bonum
      // invoice, so the payment method/status and shipping fee come from the form.
      allow create: if hasPrivilegedProfileRole()
        && request.resource.data.isManual == true
        && request.resource.data.currency == "MNT"
        && request.resource.data.schemaVersion == 1
        && isOrderStatus(request.resource.data.status)
        && isOrderSource(request.resource.data.source)
        && request.resource.data.customer.fullName is string
        && request.resource.data.customer.phoneNumber is string
        && request.resource.data.address.region is string
        && request.resource.data.address.districtOrSoum is string
        && request.resource.data.address.khorooOrBag is string
        && request.resource.data.address.streetAddress is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.payment.method is string
        && request.resource.data.payment.method.size() > 0
        && request.resource.data.payment.amount == request.resource.data.totals.grandTotal
        && request.resource.data.totals.shippingFee >= 0
        && request.resource.data.totals.grandTotal ==
             request.resource.data.totals.subtotal + request.resource.data.totals.shippingFee
        && (
          (request.resource.data.status == "new"
            && request.resource.data.payment.status == "pending"
            && request.resource.data.payment.paidAt == null)
          || (isSettledOrderStatus(request.resource.data.status)
            && request.resource.data.payment.status == "paid"
            && request.resource.data.payment.paidAt is string
            && request.resource.data.payment.paidAt.size() > 0)
        );
      allow update: if hasPrivilegedProfileRole()
        // `stockApplied` and `journalEntryId` belong here: updateOrderByAdmin moves stock and
        // posts (or reverses) the revenue entry in the same transaction as the status change.
        // `returns` is what createOrderReturn writes — without it no order could ever be
        // returned.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "source",
          "payment",
          "customer",
          "address",
          "stockApplied",
          "journalEntryId",
          "returns",
          "updatedAt",
        ])
        && isOrderStatus(request.resource.data.status)
        && isOrderSource(request.resource.data.source)
        && request.resource.data.customer.fullName is string
        && request.resource.data.customer.phoneNumber is string
        && request.resource.data.customer.phoneNumber.size() > 0
        && (request.resource.data.customer.email == null || request.resource.data.customer.email is string)
        && request.resource.data.customer.note is string
        // A chat order keeps the whole address the customer typed in `streetAddress` and
        // leaves the structured fields empty, so only that one has to be filled in.
        && request.resource.data.address.region is string
        && request.resource.data.address.districtOrSoum is string
        && request.resource.data.address.khorooOrBag is string
        && request.resource.data.address.streetAddress is string
        && request.resource.data.address.streetAddress.size() > 0
        && request.resource.data.address.additionalAddress is string
        && request.resource.data.payment.method is string
        && request.resource.data.payment.method.size() > 0
        && request.resource.data.payment.amount == resource.data.payment.amount
        // An invoice is the server's to issue and Bonum's to settle: its id never changes by
        // hand, and an order Bonum collected money for cannot be put back to unpaid.
        && request.resource.data.payment.get("invoiceId", null) == resource.data.payment.get("invoiceId", null)
        && !(resource.data.payment.status == "paid"
          && resource.data.payment.get("invoiceId", null) is string
          && request.resource.data.payment.status != "paid")
        && (
          (request.resource.data.status == "new"
            && request.resource.data.payment.status == "pending"
            && request.resource.data.payment.paidAt == null)
          || (isSettledOrderStatus(request.resource.data.status)
            && request.resource.data.payment.status == "paid"
            && request.resource.data.payment.paidAt is string
            && request.resource.data.payment.paidAt.size() > 0)
        );
      // Web (storefront) orders are never deletable. Orders from other channels can be
      // removed by an admin, except one Bonum has collected money for (that goes back through
      // a return) or one that already has returns booked against it.
      allow delete: if hasPrivilegedProfileRole()
        && resource.data.source != "web"
        && !(resource.data.payment.status == "paid" && resource.data.payment.get("invoiceId", null) is string)
        && resource.data.get("returns", []).size() == 0;
    }

    match /customers/{customerId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update, delete: if hasPrivilegedProfileRole();
    }

    // CRM: customer directory (харилцагч) sales can be booked against. Admin-only —
    // never read by a shopper's browser.
    match /crmContacts/{contactId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update, delete: if hasPrivilegedProfileRole();
    }

    match /customerTransactions/{transactionId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update, delete: if hasPrivilegedProfileRole();
    }

    match /directSales/{saleId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update, delete: if hasPrivilegedProfileRole();
    }

    // Offline sales (store, messenger, phone, …). Admin-only end to end — unlike
    // /orders these are never created or read by a shopper's browser.
    match /sales/{saleId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update, delete: if hasPrivilegedProfileRole();
    }

    match /financeEntries/{entryId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update, delete: if hasPrivilegedProfileRole();
    }

    match /financeWeeklyKpis/{weekId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update, delete: if hasPrivilegedProfileRole();
    }

    match /financeRecurring/{ruleId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update, delete: if hasPrivilegedProfileRole();
    }

    // CRM: Transfers
    match /transfers/{transferId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update: if hasPrivilegedProfileRole();
      allow delete: if false;
    }

    // CRM: Payments
    match /payments/{paymentId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create: if hasPrivilegedProfileRole();
      allow update, delete: if false;
    }

    // CRM: Stock Movements
    match /stockMovements/{movementId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create: if hasPrivilegedProfileRole();
      allow update, delete: if false;
    }

    // CRM: Customer Pricing
    match /customerPricing/{pricingId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update: if hasPrivilegedProfileRole();
      allow delete: if false;
    }

    // CRM: Customer Timeline
    match /customerTimeline/{eventId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create: if hasPrivilegedProfileRole();
      allow update, delete: if false;
    }

    // Counters (sequence generation) — only these documents are valid. Storefront order
    // numbers are deliberately absent: a shopper must never be able to write here, so those
    // are derived from the order's own document id instead (src/lib/documentNumbers.ts).
    match /counters/{counterId} {
      allow read, write: if hasPrivilegedProfileRole()
        && counterId in [
          "transfers",
          "journalEntries",
          "sales",
          "directSales",
          "customerTransactions",
          "productionBatches",
          "customers",
          "crmContacts"
        ];
      // The factory floor numbers its batches and the ledger entries its work posts. Staff
      // could not do either before, so every batch a worker created, and every completion
      // or costed purchase, failed on a permission error. They may only step a counter
      // forward by one.
      allow get: if hasStaffProfileRole() && counterId in ["productionBatches", "journalEntries"];
      allow create, update: if hasStaffProfileRole()
        && counterId in ["productionBatches", "journalEntries"]
        && isNextCounterValue();
    }

    // Finance: Chart of accounts
    match /accounts/{code} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update: if hasPrivilegedProfileRole();
      allow delete: if false;
    }

    // Finance: Journal entries (double-entry ledger) — immutable once posted; corrections
    // happen via a reversal entry, never an edit. Online-order entries are posted server-side
    // via the Admin SDK (api/_lib/postOrderPaidEntry.ts), which bypasses these rules entirely.
    match /journalEntries/{entryId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create: if hasPrivilegedProfileRole();
      // Staff post (and, when a completed batch is deleted, read back to reverse) only the
      // entries their own factory work produces, and always as themselves.
      allow get: if hasStaffProfileRole() && isFactorySourceType(resource.data.sourceType);
      allow create: if hasStaffProfileRole()
        && isFactorySourceType(request.resource.data.sourceType)
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── AI Chat ──────────────────────────────────────────────────────────────
    // Every chat write happens server-side through the Admin SDK (api/chat/*),
    // which bypasses these rules entirely. Clients therefore only ever read —
    // the browser never creates a conversation, message or lead, so there is no
    // anonymous write surface to forge a "paid" lead or a fake admin reply on.

    // Bot behaviour only. The Facebook page token used to live here; it is now
    // deployment configuration (FB_PAGE_ACCESS_TOKEN), so no credential reaches a
    // browser at all. Still admin-only: the prompt and welcome text are internal.
    match /chat_settings/{documentId} {
      allow read: if hasPrivilegedProfileRole();
      allow create, update: if hasPrivilegedProfileRole();
      allow delete: if false;
    }

    // Knowledge base. The bot reads it server-side, so no public read is needed.
    match /chat_faqs/{faqId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow create, update, delete: if hasPrivilegedProfileRole();
    }

    match /chat_conversations/{conversationId} {
      allow get: if hasPrivilegedProfileRole() || isChatConversationOwner();
      allow list: if hasPrivilegedProfileRole();
      allow write: if false;

      match /messages/{messageId} {
        allow read, list: if hasPrivilegedProfileRole()
          || isChatMessageOwner(conversationId);
        allow write: if false;
      }
    }

    // Chat-captured requests, before an admin turns one into an order.
    match /chat_leads/{leadId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow update, delete: if hasPrivilegedProfileRole();
      allow create: if false;
    }

    // What the bot replied publicly under a page post, and whether each reply
    // landed. Written by the webhook through the Admin SDK; admins read it to
    // audit what was said in public on their behalf.
    match /chat_comment_replies/{commentId} {
      allow read, list: if hasPrivilegedProfileRole();
      allow write: if false;
    }

    // Webhook de-duplication and rate-limit counters — server-only bookkeeping.
    // Both grow without bound, so each needs a Firestore TTL policy on `expireAt`.
    match /chat_processed_events/{eventId} {
      allow read, write: if false;
    }

    // Gemini context-cache handles. Written by api/chat/** through the Admin
    // SDK; a client has no use for one and should not be able to read or
    // clear another install's cache. Grows one document per prompt version,
    // so it carries a TTL like the other bookkeeping collections.
    // The resolved Facebook page token. Server-only, like every other
    // credential the chat holds — a client must never read or clear it.
    match /chat_page_tokens/{tokenId} {
      allow read, write: if false;
    }

    match /chat_prompt_caches/{cacheId} {
      allow read, write: if false;
    }

    match /chat_rate_limits/{rateLimitId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || hasPrivilegedProfileRole();
      allow create: if isSelf(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "customer";
      allow update: if isSelf(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow update: if hasPrivilegedProfileRole()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "email",
          "phoneNumber",
          "role",
          "updatedAt",
        ])
        && isValidUserRole(request.resource.data.role)
        // Only a sysadmin grants or takes away sysadmin — an admin used to be able to make
        // anyone, themselves included, a sysadmin.
        && (profileRole() == "sysadmin"
          || (request.resource.data.role != "sysadmin" && resource.data.role != "sysadmin"))
        && (request.resource.data.displayName == null || request.resource.data.displayName is string)
        && (request.resource.data.email == null || request.resource.data.email is string)
        && (request.resource.data.phoneNumber == null || request.resource.data.phoneNumber is string);
      allow delete: if false;
    }
  }
}
