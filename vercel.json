{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/__/auth/:path*", "destination": "https://savana-3f45a.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://savana-3f45a.firebaseapp.com/__/firebase/:path*" },
    { "source": "/((?!api/|__/).*)", "destination": "/index.html" }
  ]
}
